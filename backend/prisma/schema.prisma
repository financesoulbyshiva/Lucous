generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ----------------------------- Auth ----------------------------------------
// MongoDB connector has no native enums, so role/status/mode/difficulty are
// stored as strings and validated in the application layer (server.js).

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String
  role       String   @default("STUDENT") // STUDENT | PARENT | TEACHER | ADMIN
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempts        Attempt[]
  progress        StudentProgress[]
  materials       UploadedMaterial[]
  authoredContent LearningContent[] @relation("ContentAuthor")
  courses         Course[]
  enrollments     Enrollment[]
  otps            Otp[]
}

model Otp {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  purpose   String    @default("VERIFY") // VERIFY | RESET
  expiresAt DateTime
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now())
  userId    String?   @db.ObjectId
  user      User?     @relation(fields: [userId], references: [id])

  @@index([email])
}

// ------------------- Scalable education structure (data) --------------------
// Board -> Grade (Class) -> Subject -> Chapter -> Topic -> Content/Question.

model Board {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  subjects Subject[]
}

model Grade {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  subjects Subject[]
}

model Subject {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  boardId   String             @db.ObjectId
  gradeId   String             @db.ObjectId
  board     Board              @relation(fields: [boardId], references: [id])
  grade     Grade              @relation(fields: [gradeId], references: [id])
  chapters  Chapter[]
  materials UploadedMaterial[]

  @@unique([boardId, gradeId, name])
}

model Chapter {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  subjectId String             @db.ObjectId
  subject   Subject            @relation(fields: [subjectId], references: [id])
  name      String
  topics    Topic[]
  materials UploadedMaterial[]

  @@unique([subjectId, name])
}

model Topic {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  chapterId String            @db.ObjectId
  chapter   Chapter           @relation(fields: [chapterId], references: [id])
  name      String
  contents  LearningContent[]
  questions Question[]
  attempts  Attempt[]
  materials UploadedMaterial[]

  @@unique([chapterId, name])
}

// ------------------------- Content + AI pipeline fields ---------------------

model LearningContent {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  topicId    String            @db.ObjectId
  topic      Topic             @relation(fields: [topicId], references: [id])
  title      String
  body       String
  order      Int               @default(0)
  source     String            @default("TEACHER") // TEACHER | UPLOADED | AI
  status     String            @default("PUBLISHED") // DRAFT | PENDING_REVIEW | PUBLISHED
  authorId   String?           @db.ObjectId
  author     User?             @relation("ContentAuthor", fields: [authorId], references: [id])
  materialId String?           @db.ObjectId
  material   UploadedMaterial? @relation(fields: [materialId], references: [id])
  progress   StudentProgress[]
}

model Question {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  topicId     String            @db.ObjectId
  topic       Topic             @relation(fields: [topicId], references: [id])
  text        String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  correct     Int
  explanation String?
  difficulty  String            @default("MEDIUM") // EASY | MEDIUM | HARD
  source      String            @default("TEACHER")
  status      String            @default("PUBLISHED")
  materialId  String?           @db.ObjectId
  material    UploadedMaterial? @relation(fields: [materialId], references: [id])
}

// -------------------- Teacher upload / AI pipeline foundation ---------------

model UploadedMaterial {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  teacherId    String            @db.ObjectId
  teacher      User              @relation(fields: [teacherId], references: [id])
  originalName String
  fileType     String
  fileSize     Int
  boardId      String?           @db.ObjectId
  gradeId      String?           @db.ObjectId
  subjectId    String?           @db.ObjectId
  chapterId    String?           @db.ObjectId
  topicId      String?           @db.ObjectId
  subject      Subject?          @relation(fields: [subjectId], references: [id])
  chapter      Chapter?          @relation(fields: [chapterId], references: [id])
  topic        Topic?            @relation(fields: [topicId], references: [id])
  status       String            @default("UPLOADED") // UPLOADED | PROCESSING | ANALYZED | READY | FAILED
  createdAt    DateTime          @default(now())
  contents     LearningContent[]
  questions    Question[]

  @@index([teacherId])
}

// --------------------------- Attempts + progress ----------------------------

model Attempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  topicId   String   @db.ObjectId
  topic     Topic    @relation(fields: [topicId], references: [id])
  mode      String // PLAY | PRACTICE | TEST | RETEST
  correct   Int
  total     Int
  score     Float
  createdAt DateTime @default(now())

  @@index([userId])
}

model StudentProgress {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  userId      String          @db.ObjectId
  user        User            @relation(fields: [userId], references: [id])
  contentId   String          @db.ObjectId
  content     LearningContent @relation(fields: [contentId], references: [id])
  completedAt DateTime        @default(now())

  @@unique([userId, contentId])
}

// ------------------------------ Courses -------------------------------------

model Course {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  subject     String
  board       String
  teacherId   String       @db.ObjectId
  teacher     User         @relation(fields: [teacherId], references: [id])
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]

  @@index([teacherId])
}

// ---------------------------- Enrollment ------------------------------------

model Enrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId   String   @db.ObjectId
  course    Course   @relation(fields: [courseId], references: [id])
  studentId String   @db.ObjectId
  student   User     @relation(fields: [studentId], references: [id])
  teacherId String?  @db.ObjectId
  status    String   @default("ENROLLED")
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([teacherId])
}
